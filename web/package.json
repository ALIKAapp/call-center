{
  "name": "call-center-web",
  "private": true,
  "description": "Source of the Call Center website. `npm run build` writes the site to ../docs (served by GitHub Pages).",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=chrome100,edge100 --outfile=../docs/app.js && cp index.html ../docs/index.html"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-credential-web": "2.1.0",
    "@yume-chan/adb-daemon-webusb": "2.3.2",
    "@yume-chan/stream-extra": "2.6.1",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
